      "name": "恐贪指数",
      "covered": true,
      "assertion": "stock/feargreed"
    },
    {
      "name": "择时综合分",
      "covered": true,
      "assertion": "stock/composite"
    },
    {
      "name": "周期定位",
      "covered": true,
      "assertion": "cycle_global/cycle-us+cycle-cn+cycle-date"
    },
    {
      "name": "股债性价比(ERP)",
      "covered": false
    },
    {
      "name": "A股情绪",
      "covered": false
    },
    {
      "name": "融资余额",
      "covered": false
    },
    {
      "name": "美债10Y",
      "covered": true,
      "assertion": "stock/ust10y-value"
    },
    {
      "name": "VIX",
      "covered": false
    },
    {
      "name": "美元人民币",
      "covered": true,
      "assertion": "stock/usdcny-value"
    },
    {
      "name": "破净率",
      "covered": true,
      "assertion": "stock/break-net-rate-value"
    },
    {
      "name": "股息率利差",
      "covered": true,
      "assertion": "stock/dividend-spread-value"
    },
    {
      "name": "联邦基金利率",
      "covered": true,
