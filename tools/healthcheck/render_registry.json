{
  "version": "1.1",
  "updated": "2026-11-12",
  "note": "呈现层断言登记表：页面实际显示值 ←→ 数据源值。新增卡片必须在此登记，未登记卡片不计覆盖率。制度裁决⑤：核心卡 12 张 100% 覆盖，分三步 12月6张/1月9张/3月12张。tolerance 为绝对容差（渲染四舍五入后允许的误差）。取值方式：selector（CSS，可选 index）/ card_name（指标卡 .ind-name 精确匹配）/ 缺省用 DOM id；pattern 为正则第 1 组。",
  "pages": [
    {
      "name": "stock",
      "url": "/stock_dashboard.html",
      "title_sub": "A股",
      "wait_ms": 6000,
      "values": [
        {
          "id": "usdcny-value",
          "label": "USDCNY",
          "file": "data/us_macro.json",
          "path": "history.usdcny[-1].value",
          "tolerance": 0.0002,
          "decimals": 4
        },
        {
          "id": "ust10y-value",
          "label": "美债10Y",
          "file": "data/us_macro.json",
          "path": "history.yield_10y[-1].value",
          "tolerance": 0.011,
          "decimals": 2,
          "suffix": "%"
        },
        {
          "id": "fed-rate-value",
          "label": "联邦基金利率",
          "file": "data/us_macro.json",
          "path": "lagging.fed_funds_rate.value",
          "tolerance": 0.011,
          "decimals": 2,
          "suffix": "%"
        },
        {
          "id": "break-net-rate-value",
          "label": "破净率",
          "file": "data/timing_scores.json",
          "path": "dimensions.valuation.indicators.break_net_rate.value",
          "tolerance": 0.011,
          "decimals": 2,
          "suffix": "%"
        },
        {
          "id": "dividend-spread-value",
          "label": "股息率利差",
          "file": "data/timing_scores.json",
          "path": "dimensions.equity_bond.indicators.dividend_bond_spread_red.value",
          "tolerance": 0.02,
          "decimals": 2,
          "suffix": "%"
        },
        {
          "id": "feargreed",
          "label": "恐贪指数",
          "card_name": "恐贪指数",
          "file": "data/feargreed_pointer.json",
          "path": "score",
          "tolerance": 0.26,
          "decimals": 1,
          "note": "指标卡按 .ind-name 精确匹配取 .ind-value；源=QVIX 单因子恐贪指针"
        },
        {
          "id": "composite",
          "label": "择时综合分",
          "selector": "#bucket-dist .bd-summary",
          "pattern": "当前\\s*([\\d.]+)\\s*分",
          "file": "data/timing_scores.json",
          "path": "composite_score",
          "tolerance": 0.15,
          "decimals": 1,
          "note": "分桶分布摘要行的『当前 X 分』，直接来自 timing_scores.composite_score"
        }
      ]
    },
    {
      "name": "cycle_global",
      "url": "/index.html",
      "title_sub": "宏观",
      "click": "button[data-tab=cycle]",
      "wait_ms": 6000,
      "values": [
        {
          "id": "cycle-us",
          "label": "周期定位-美国共识分",
          "selector": ".v4-hero-score",
          "index": 0,
          "file": "data/cycle_position_v4.json",
          "path": "cycle_consensus.united_states.consensus_score",
          "tolerance": 0.15,
          "decimals": 1
        },
        {
          "id": "cycle-cn",
          "label": "周期定位-中国共识分",
          "selector": ".v4-hero-score",
          "index": 1,
          "file": "data/cycle_position_v4.json",
          "path": "cycle_consensus.china.consensus_score",
          "tolerance": 0.15,
          "decimals": 1
        },
        {
          "id": "cycle-date",
          "label": "周期定位-更新日期",
          "selector": ".v4-hero-date",
          "file": "data/cycle_position_v4.json",
          "path": "cycle_consensus.last_updated",
          "type": "date",
          "note": "防 F10 类『更新于 vs 数据尾错位』"
        }
      ]
    },
    {
      "name": "macro_econ",
      "url": "/macro-econ-dashboard/index.html",
      "title_sub": "宏观",
      "wait_ms": 6000,
      "values": []
    }
  ],
  "badge_rules": {
    "note": "徽标失真门禁：带「✅最新」的徽标，其日期必须落在该频率的正常发布周期内，否则 FAIL。",
    "cycle_days": {
      "日频": 7,
      "周频": 21,
      "月频": 60,
      "季频": 120,
      "半年频": 200,
      "年频": 400,
      "日": 7,
      "周": 21,
      "月": 60,
      "季": 120,
      "半年": 200,
      "年": 400
    }
  },
  "mock_markers": {
    "note": "页面硬编码 mock 兜底快照的 updateTime 字样；出现在可见文本即说明真实数据未覆盖成功（静默降级）。",
    "tokens": [
      "2026-08 (周频)",
      "2026Q3 (季频)",
      "2026-08 (月频)"
    ]
  },
  "core_cards": [
